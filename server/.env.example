# Copy this file to .env and replace local values before starting the API.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/readsmart
JWT_SECRET=replace-with-a-private-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=1h

# Browser-based Expo Web origins only. Native Android/iOS apps are not subject to browser CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Optional administrator bootstrap credentials used only by `npm run create-admin`.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional local-only AI configuration. The backend accepts Ollama on loopback only.
# Check `ollama list` and set OLLAMA_MODEL to an exact model name already installed locally.
# Leave OLLAMA_MODEL blank to keep AI features disabled until a local model is available.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL= 
OLLAMA_NUM_CTX=4096
AI_TIMEOUT_MS=90000
